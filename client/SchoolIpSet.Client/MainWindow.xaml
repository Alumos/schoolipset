<Window x:Class="SchoolIpSet.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP Sentinel"
        Width="700" Height="550" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0A1020" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EEF2F5" />
            <Setter Property="Foreground" Value="#435066" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#0A1020" />
            <Setter Property="Background" Value="#F7F9FB" />
            <Setter Property="BorderBrush" Value="#E3E8EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,10" />
        </Style>
    </Window.Resources>
    <Border CornerRadius="24" Background="#F5F7FB" BorderBrush="#DDE4EC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0A1020" CornerRadius="24,24,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="25,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" Background="#B8F2DC" CornerRadius="11"><TextBlock Text="✓" FontSize="19" FontWeight="Bold" Foreground="#0A1020" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="IP SENTINEL" Foreground="White" FontSize="13" FontWeight="Bold" /><TextBlock Text="教师办公网络监测" Foreground="#7F8B9E" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                    </StackPanel>
                    <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Padding="0" Background="Transparent" Foreground="#8B96A7" BorderThickness="0" Content="×" FontSize="22" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="34,28,34,34">
                <StackPanel>
                    <TextBlock Text="你的办公网络" FontSize="25" FontWeight="SemiBold" Foreground="#0A1020" />
                    <TextBlock Text="客户端会定期检查网卡配置，并在发现差异时给出清晰的处理建议。" Margin="0,8,0,0" Foreground="#718096" FontSize="13" />
                    <Border x:Name="EnrollmentCard" Margin="0,24,0,0" Background="White" CornerRadius="18" Padding="22" BorderBrush="#E4EAF0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="首次连接" FontSize="16" FontWeight="SemiBold" Foreground="#0A1020" />
                            <TextBlock Text="请输入你的姓名，用于匹配后台分配的办公 IP。" Margin="0,6,0,0" Foreground="#718096" FontSize="12" />
                            <TextBox x:Name="NameBox" Style="{StaticResource FieldStyle}" Margin="0,17,0,0" Height="42" />
                            <Button x:Name="RegisterButton" Click="Register_Click" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Height="42" Content="连接并开始监测" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatusCard" Margin="0,24,0,0" Background="White" CornerRadius="18" Padding="22" BorderBrush="#E4EAF0" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <StackPanel><TextBlock Text="当前状态" FontSize="11" Foreground="#9AA5B5" /><TextBlock x:Name="StatusText" Text="等待连接" Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#0A1020" /></StackPanel>
                                <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EEF2F5" CornerRadius="12" Padding="10,6"><TextBlock x:Name="StatusBadgeText" Text="待连接" Foreground="#718096" FontSize="11" FontWeight="SemiBold" /></Border>
                            </Grid>
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="当前 IPv4" FontSize="11" Foreground="#9AA5B5" /><TextBlock x:Name="CurrentIpText" Text="—" Margin="0,6,0,0" FontFamily="Consolas" FontSize="16" Foreground="#435066" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="匹配的办公 IP" FontSize="11" Foreground="#9AA5B5" /><TextBlock x:Name="TargetIpText" Text="—" Margin="0,6,0,0" FontFamily="Consolas" FontSize="16" Foreground="#435066" /></StackPanel>
                            </Grid>
                            <TextBlock x:Name="DetailText" Text="尚未完成第一次检测。" Margin="0,18,0,0" Foreground="#718096" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ActionCard" Visibility="Collapsed" Margin="0,16,0,0" Background="#FFF9EB" CornerRadius="18" Padding="22" BorderBrush="#F5E4B6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="发现配置差异" FontSize="16" FontWeight="SemiBold" Foreground="#8A5B00" />
                            <TextBlock Text="后台为你分配了新的办公网络配置。点击一键修改后，系统会请求 Windows 管理员权限，自动设置 IP、子网掩码、网关和 DNS，并验证网络；验证失败会尝试恢复原配置。" Margin="0,7,0,0" Foreground="#9B7530" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                                <Button x:Name="ApplyButton" Click="Apply_Click" Style="{StaticResource PrimaryButton}" Height="40" Padding="17,8" Content="一键修改并验证" />
                                <Button x:Name="DeclineButton" Click="Decline_Click" Style="{StaticResource SecondaryButton}" Height="40" Margin="10,0,0,0" Content="暂不修改" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="MessageText" Text="" Margin="2,18,2,0" Foreground="#9AA5B5" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
